@startuml
!include <C4/C4_Context.puml>

System_Boundary(dfd, "Потоки данных между доменами") {

    System(clinical, "Домен «Клиники»")
    System(fintech, "Домен «Финтех»")
    System(ai, "Домен «ИИ-сервисы»")
    System(analytics, "Домен «Аналитика & Data Portal»")
    System(kafka, "Kafka (событийная шина)")

    System_Ext(pharma, "Фармацевтические партнёры")
    System_Ext(electronics, "Производитель электроники")
    System_Ext(regulator, "Регуляторы (ЦБ, Росздравнадзор)")
    System_Ext(legacy_dwh, "SQL Server 2008 (архив)")
}

Rel(clinical, kafka, "События: запись, отмена, инвентаризация", "CDC/Debezium")
Rel(fintech, kafka, "События: платёж, кредит, просрочка", "API")
