Rel(clinical, analytics, "Агрегаты по SLA (витрина клиник)", "gRPC / Batch")
Rel(fintech, analytics, "Агрегаты по SLA (витрина финтеха)", "gRPC / Batch")
Rel(ai, analytics, "Метрики качества моделей (без диагнозов)", "gRPC / Batch")

Rel(analytics, regulator, "Отчётность (фин. + операционная)", "API / SFTP")
Rel(analytics, pharma, "Обезличенные метаданные об эффективности", "Data Marketplace")
Rel(electronics, ai, "Поток данных с устройств (ЭКГ, тонометры)", "MQTT / Kafka")

Rel(legacy_dwh, clinical, "Историческая выгрузка (однократная)", "ETL")
Rel(legacy_dwh, fintech, "Исторические транзакции", "ETL")

@enduml